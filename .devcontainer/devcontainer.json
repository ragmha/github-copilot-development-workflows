{
  "name": "GitHub Copilot Development Workflows",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/oven-sh/devcontainer-features/bun:1": {
      "version": "1.3.14"
    }
  },
  "postCreateCommand": "bun install",
  "customizations": {
    "vscode": {
      "extensions": ["github.copilot", "github.copilot-chat", "biomejs.biome"]
    }
  }
}
